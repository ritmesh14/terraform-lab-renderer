# Copy to terraform.tfvars and replace BOTH values with real key material.
# admin_public_key  = the .pub contents (what the VM trusts)
# admin_private_key = the full private key (what the provisioner SSHes in with)
admin_public_key  = "ssh-rsa AAAA... replace-with-your-public-key"
admin_private_key = "-----BEGIN OPENSSH PRIVATE KEY----- ... -----END OPENSSH PRIVATE KEY-----"